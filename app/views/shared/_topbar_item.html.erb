<%# #1109 (Hans, 2026-07-22): Ein anpassbares Topbar-Element nach seiner ID
    rendern — zentrale Registry, damit Bereich (links/rechts/ausgeblendet)
    und Reihenfolge aus den Vorlieben (pref_topbar_layout) getrieben werden
    koennen. Gegenstueck zu sidebar_item (#846). Unbekannte IDs => nichts
    (robust gegen alte gespeicherte Layouts).

    Die quick_*-Icons brauchen den quick-create-Stimulus-Scope: der
    Controller sitzt seit #1109 auf dem <header>, die Eingabeslots liegen
    in shared/_quick_create_bar — Icons duerfen daher in beiden Zonen
    stehen. Locals: item_id (String). %>
<% case item_id.to_s %>
<% when "quick_task", "quick_awaiting", "quick_ki", "quick_person", "quick_inbox" %>
  <% slot = item_id.to_s.delete_prefix("quick_") %>
  <%= ui_button :"schnellanlage_#{slot}", size: "w-4 h-4",
        "aria-label": t("shared.quick_create.#{slot}_aria"),
        data: { action: "quick-create#toggle", quick_create_slot_param: slot },
        class: "p-1.5 rounded text-slate-500 hover:bg-slate-100 hover:text-slate-900 cursor-pointer" %>
<% when "timer" %>
  <%# #533 Phase 1b: Zeit-Timer. #857: auf Mobil ausgeblendet — Toolbar war
      zu voll; md:contents laesst das Desktop-Flex-Layout unveraendert. %>
  <div class="hidden md:contents"><%= render "shared/time_timer" %></div>
<% when "theme" %>
  <%# #772 (Hans, 2026-06-27): Dark-Mode-Umschalter. Mond im Hell-Modus
      (Klick → dunkel), Sonne im Dunkel-Modus (Klick → hell); per CSS
      umgeschaltet (html.dark), kein JS-Icon-Tausch noetig. %>
  <%# Zwei Symbole in einem Knopf (Mond/Sonne, per CSS getauscht) — als Block. %>
  <%= ui_button :dark_mode_umschalten,
        "aria-label": t("shared.topbar.theme_label"),
        "aria-pressed": (cookies[:theme] == "dark").to_s,
        data: { controller: "theme", action: "click->theme#toggle", ui_label: "Dark-Mode-Umschalter" },
        class: "hidden md:block p-1.5 rounded text-slate-400 hover:bg-slate-100 hover:text-slate-700 cursor-pointer" do %>
    <span class="theme-icon-moon flex [&_svg]:w-4 [&_svg]:h-4"><%= icon "moon" %></span>
    <span class="theme-icon-sun hidden [&_svg]:w-4 [&_svg]:h-4"><%= icon "sun" %></span>
  <% end %>
<% when "shortcuts" %>
  <%# #759 (Hans, 2026-06-23): Tastatur-Shortcut-Uebersicht. Oeffnet dasselbe
      Modal wie die Taste „?" — der shortcut-help-Controller faengt das vom
      Blade-Stack dispatchte Event ab, daher funktioniert der Trigger auch
      hier in der Topbar (ausserhalb des Stack-Scopes). %>
  <%= ui_button :tastatur_hilfe, size: "w-4 h-4",
        "aria-label": t("shared.topbar.shortcuts_label"),
        data: { controller: "shortcut-help", action: "click->shortcut-help#open",
                ui_label: "Tastatur-Shortcuts (Hilfe)" },
        class: "hidden md:block p-1.5 rounded text-slate-400 hover:bg-slate-100 hover:text-slate-700 cursor-pointer" %>
<% when "inspector" %>
  <%# #704 (Hans): Beschriftungs-Modus — Labels per Hover anzeigen, per
      Klick kopieren. Shortcut: Cmd/Ctrl + . %>
  <%= ui_button :beschriftungs_modus, size: "w-4 h-4",
        "aria-label": t("shared.topbar.inspector_label"), "aria-pressed": "false",
        data: { controller: "ui-inspector", action: "click->ui-inspector#toggle",
                ui_label: "Beschriftungs-Modus (Schalter)" },
        class: "hidden md:block p-1.5 rounded text-slate-400 hover:bg-slate-100 hover:text-slate-700 cursor-pointer" %>
<% when "diagnostic" %>
  <%# #339 (Hans): Diagnose-Knopf — schreibt einen JSON-Snapshot des
      aktuellen Blade-Stack-Zustands in ein Overlay. %>
  <%= ui_button :diagnose_schnappschuss, size: "w-4 h-4",
        "aria-label": t("shared.topbar.diagnostic_label"),
        data: { controller: "diagnostic-snapshot", action: "click->diagnostic-snapshot#snapshot" },
        class: "hidden md:block p-1.5 rounded text-slate-400 hover:bg-slate-100 hover:text-slate-700 cursor-pointer" %>
<% end %>
