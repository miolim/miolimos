<%# #1321 (Hans, 2026-08-07): Das Schnell-Dropdown. Es bleibt der schnelle
    Blick — je Sammlung die ersten acht Zeilen, bewusst OHNE Trefferzahlen
    (die Aktion feuert je Tastendruck; elf COUNT-Queries wären dort
    Verschwendung). Wer mehr will, öffnet unten die Ergebnis-Card.

    Sektionen und Zeilen kommen aus denselben Partials wie die Card; die
    Sammlungen samt Reihenfolge stehen in SearchQuery::SECTIONS. %>
<%= turbo_frame_tag "search_results" do %>
  <% unless @search.blank? %>
    <div class="bg-white rounded-b border border-slate-200 shadow-lg max-h-[70vh] overflow-y-auto">
      <% shown = 0 %>
      <% SearchQuery::SECTIONS.each do |section| %>
        <% records = @search.records(section, limit: SearchController::DROPDOWN_LIMIT) %>
        <% next if records.empty? %>
        <% shown += records.size %>
        <div class="px-4 py-1 text-[11px] uppercase tracking-wider text-slate-500 bg-slate-50">
          <%= search_section_label(section) %>
        </div>
        <%= render "search/rows", search: @search, section: section,
              records: records, snippets: @search.snippets(section, records) %>
      <% end %>

      <% if shown.zero? %>
        <p class="px-4 py-3 text-slate-500 text-sm"><%= t("search.no_results", query: @search.query) %></p>
      <% else %>
        <%# Einstieg in die Ergebnis-Card. Auf einer Stack-Seite hängt
            blade-link sie an den Stack; sonst folgt der Klick dem href und
            baut den Stack auf dem Dashboard auf. %>
        <%= link_to dashboard_path(stack: "list:dashboard,list:search:#{@payload}"),
              data: { controller: "blade-link",
                      "blade-link-kind-value": "search_list",
                      "blade-link-id-value": @payload,
                      action: "click->blade-link#append",
                      turbo_frame: "_top" },
              class: "flex items-center gap-2 px-4 py-2 border-t border-slate-200 bg-slate-50
                      text-[13px] text-emerald-700 hover:bg-slate-100" do %>
          <span class="text-emerald-600"><%= icon "search", size: "w-4 h-4" %></span>
          <%= t("search.show_all") %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
