<%# #1520 (Hans): Adresse eintragen, Link kommt per Mail. Die Seite sagt
    bewusst NICHT, ob es die Adresse gibt — sonst waere sie ein Verzeichnis
    aller Konten. %>
<% content_for :title, t("passwords.forgot_heading") %>

<div class="w-full max-w-sm rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
  <div class="flex items-center gap-2 mb-4">
    <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
    <span class="font-semibold text-slate-900">miolimOS</span>
  </div>
  <h1 class="text-lg font-semibold mb-1"><%= t("passwords.forgot_heading") %></h1>
  <p class="text-xs text-slate-500 mb-4"><%= t("passwords.forgot_hint") %></p>

  <%= form_with url: password_resets_path, method: :post, local: true do |f| %>
    <div class="mb-4">
      <%= f.label :email, t("sessions.email"), class: "block text-xs text-slate-600 mb-1" %>
      <%= f.email_field :email, autofocus: true, required: true,
            class: "w-full rounded border border-slate-200 px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-emerald-400" %>
    </div>
    <%= f.submit t("passwords.forgot_submit"),
          class: "w-full rounded bg-emerald-600 text-white font-medium py-1.5 hover:bg-emerald-700 cursor-pointer" %>
  <% end %>

  <p class="mt-4 text-xs text-slate-500">
    <%= link_to t("passwords.back_to_login"), login_path, class: "hover:text-slate-700 underline" %>
  </p>
</div>
