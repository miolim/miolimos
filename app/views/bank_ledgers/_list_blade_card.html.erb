<%# #1337 Schnitt 4: Listen-Blade aller Bankkonten. Je Zeile Bezeichnung/IBAN
    und der Saldo MIT Stichtag — ein Kontostand ohne Datum ist die Auskunft,
    die fehlt, wenn der letzte Auszug drei Monate zurückliegt. %>
<%
  stack_id = "list:bank_ledgers"
  ledgers  = BankLedger.ordered.to_a
%>
<article id="stack_card_<%= stack_id %>"
         data-uuid="<%= stack_id %>"
         class="stack-card shrink-0 relative w-[26rem] max-w-[calc(100vw-3rem)]
                bg-white border-l border-slate-200 first:border-l-0 flex">

  <%= render "shared/list_blade_spine",
        title: t("bank.ledgers.title"), icon_html: icon("file_text"),
        stack_id: stack_id, label: t("bank.ledgers.title") %>

  <div class="flex-1 min-w-0 min-h-0 overflow-y-auto p-3 space-y-2">
    <%= render "shared/list_blade_toolbar", stack_id: stack_id %>

    <div class="sticky -top-3 -mx-3 -mt-3 px-3 pt-3 pb-2 bg-white/95 backdrop-blur z-20
                border-b border-slate-100 flex items-center gap-2">
      <span class="font-semibold text-sm"><%= t("bank.ledgers.title") %></span>
      <span class="text-xs text-slate-400 tabular-nums shrink-0"><%= ledgers.size %></span>
      <%= button_to bank_ledgers_path, method: :post,
            form: { class: "ml-auto inline" },
            class: "text-xs px-2 py-0.5 rounded text-emerald-700 hover:bg-emerald-50 cursor-pointer" do %><%= t("bank.ledgers.add") %><% end %>
    </div>

    <% if ledgers.empty? %>
      <p class="text-slate-400 italic text-[13px]"><%= t("bank.ledgers.none") %></p>
    <% end %>

    <% ledgers.each do |l| %>
      <button type="button"
              data-controller="blade-link" data-blade-link-kind-value="bank_ledger"
              data-blade-link-id-value="<%= l.id %>" data-action="click->blade-link#append"
              class="w-full text-left px-2 py-1.5 rounded border border-slate-100 hover:bg-slate-50 cursor-pointer">
        <div class="flex items-center gap-2">
          <span class="font-medium text-[13px] truncate"><%= l.full_label %></span>
          <span class="ml-auto tabular-nums text-[13px] <%= "text-rose-700" if l.balance.negative? %>">
            <%= document_euro(l.balance) %>
          </span>
        </div>
        <div class="flex items-center gap-2 text-[11px] text-slate-400">
          <span class="truncate"><%= l.iban.presence || "—" %></span>
          <% if l.balance_on %>
            <span class="ml-auto shrink-0"><%= t("bank.ledgers.as_of", date: l(l.balance_on, format: :short)) %></span>
          <% end %>
        </div>
      </button>
    <% end %>
  </div>
</article>
