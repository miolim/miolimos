<%# #1321 / #395: Antworten (Reply-KIs) haben keinen eigenen Titel und keine
    eigene Card — die Zeile zeigt den Eltern-Datensatz und springt auf dessen
    Anker. Deshalb kein blade-link, sondern eine normale Navigation.

    Locals: reply, parent (Task oder KnowledgeItem), snippet %>
<% parent_path =
     if reply.parent_type == "Task"
       task_path(parent.id) + "#reply_#{reply.uuid}"
     else
       knowledge_item_path(parent.uuid) + "#reply_#{reply.uuid}"
     end %>
<li class="px-4 py-1.5 hover:bg-slate-50">
  <%= link_to parent_path, data: { turbo_frame: "_top" }, class: "block hover:underline" do %>
    <div class="flex items-center gap-2 text-xs text-slate-500">
      <span class="shrink-0">
        <%= icon reply.parent_type == "Task" ? "tasks" : "knowledge", size: "w-3 h-3" %>
      </span>
      <span class="truncate font-medium text-slate-700"><%= parent.title.to_s.presence || t("search.no_title") %></span>
      <span class="text-slate-400 shrink-0"><%= t("search.reply_from", name: reply.creator&.name) %></span>
    </div>
    <% if snippet.present? %>
      <div class="text-xs text-slate-500 truncate pl-5"><%= sanitize snippet, tags: %w[mark] %></div>
    <% end %>
  <% end %>
</li>
